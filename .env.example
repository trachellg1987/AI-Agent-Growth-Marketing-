# Copy to .env and fill in ONE provider. .env is git-ignored. Never commit real keys.
# The agents read these from the environment; load them with: set -a; . ./.env; set +a

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Force a provider when both keys are set: anthropic or openai
# LLM_PROVIDER=anthropic
